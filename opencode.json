{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "SESSION.md",
    ".opencode/skill/site-otomasyon-kurallari.md"
  ],
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4-flash",
  "agent": {
    "planner": {
      "description": "Tip A/E — strateji, spec, karar (Zen)",
      "model": "opencode/claude-sonnet-4-5",
      "mode": "primary"
    },
    "coder": {
      "description": "Tip B — component/kod yazımı",
      "model": "opencode-go/deepseek-v4-pro",
      "mode": "primary"
    },
    "debugger": {
      "description": "Tip C — hata analizi (Zen)",
      "model": "opencode/claude-haiku-4-5",
      "mode": "primary"
    },
    "quick": {
      "description": "Tip D/G — hızlı/düşük context işler",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "primary"
    }
  },
  "plugin": ["@dietrichgebert/ponytail"],
  "mcp": {
    "21st": {
      "type": "remote",
      "url": "https://21st.dev/api/mcp",
      "enabled": true,
      "headers": {
        "x-api-key": "$21ST_API_KEY"
      }
    },
    "agentmemory": {
      "type": "local",
      "command": ["npx", "-y", "@agentmemory/mcp"],
      "enabled": false
    }
  }
}
