{
  "name": "N-PAK Ambalaj",
  "version": "2.0.0",
  "vibe": {
    "industry": "imalat / endustriyel",
    "personality": "guclu, guvenilir, teknik, koruyucu, profesyonel",
    "audience": "satinalma muhendisleri, fabrika mudurleri, AR-GE ekipleri",
    "metaphor": "celik kasa - saglam, sade, islevsel"
  },
  "colors": {
    "background": { "value": "#F8FAFC", "type": "color" },
    "foreground": { "value": "#0F172A", "type": "color" },
    "primary": { "value": "#1E293B", "type": "color" },
    "accent": { "value": "#D97706", "type": "color" },
    "accent-hover": { "value": "#B45309", "type": "color" },
    "surface": { "value": "#FFFFFF", "type": "color" },
    "muted": { "value": "#64748B", "type": "color" },
    "border": { "value": "rgba(15, 23, 42, 0.06)", "type": "color" }
  },
  "typography": {
    "heading": { "value": "'Oswald', sans-serif", "type": "fontFamily" },
    "body": { "value": "'Inter', sans-serif", "type": "fontFamily" },
    "scale": {
      "h1": { "size": "clamp(2.5rem, 3vw + 1rem, 3.75rem)", "weight": "700", "lineHeight": "1.05", "tracking": "-0.02em" },
      "h2": { "size": "clamp(1.75rem, 2vw + 0.5rem, 2.5rem)", "weight": "600", "lineHeight": "1.1" },
      "h3": { "size": "clamp(1.25rem, 1vw + 0.25rem, 1.5rem)", "weight": "600", "lineHeight": "1.2" },
      "h4": { "size": "clamp(1.125rem, 0.5vw + 0.5rem, 1.25rem)", "weight": "600", "lineHeight": "1.3" },
      "body": { "size": "clamp(1rem, 0.5vw + 0.5rem, 1.125rem)", "weight": "400", "lineHeight": "1.6" },
      "small": { "size": "0.875rem", "weight": "400", "lineHeight": "1.5" },
      "caption": { "size": "0.75rem", "weight": "400", "lineHeight": "1.4" }
    },
    "allcaps": { "size": "0.75rem", "weight": "600", "tracking": "0.06em" }
  },
  "spacing": {
    "section": "5rem",
    "container": "1280px"
  },
  "radius": {
    "card": "1rem",
    "button": "9999px",
    "input": "0.75rem"
  },
  "shadows": {
    "card": "0 1px 3px rgba(0,0,0,0.06)",
    "elevated": "0 10px 40px rgba(0,0,0,0.08)"
  },
  "components": {
    "button-primary": "inline-flex items-center justify-center gap-2 rounded-full bg-accent px-8 py-3.5 font-heading text-sm font-semibold tracking-wider text-primary transition-all hover:bg-accent-hover",
    "button-outline": "inline-flex items-center justify-center gap-2 rounded-full border border-primary/20 px-8 py-3.5 font-heading text-sm font-semibold tracking-wider text-foreground transition-all hover:border-accent hover:text-accent",
    "card": "rounded-2xl border border-border bg-surface p-6 transition-all hover:-translate-y-1 hover:border-accent/30 hover:shadow-elevated",
    "badge": "inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-4 py-1.5 text-xs font-medium text-foreground"
  }
}
